# Frontend only (Vite / React). Used by Vercel Hobby (must be set BEFORE build / Redeploy).
# Do NOT put database credentials here.

# Local `npm run dev`: leave empty — Vite proxies /api → http://localhost:8080
VITE_API_URL=

# Production (Vercel): public Spring Boot URL on Render, NO trailing slash.
# Example (replace with your real Render URL):
# VITE_API_URL=https://warmup-library.onrender.com
#
# Final requests become:
#   ${VITE_API_URL}/api/games
#   ${VITE_API_URL}/api/filters
#   ${VITE_API_URL}/api/games/{id}
#   ${VITE_API_URL}/api/games/{id}/reviews
#
# Do NOT set VITE_API_URL to the Vercel frontend URL.
