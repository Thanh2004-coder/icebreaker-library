# Copy into the host / IDE / cloud dashboard. Do not commit real secrets.

# --- Backend (Spring Boot + PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/warmup_library
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
PORT=8080
# Local + Vercel production origin, comma-separated. Use allowed origin patterns if needed.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite production build) ---
# Local `npm run dev` uses the Vite proxy and can leave this empty.
VITE_API_URL=

