# =============================================================================
# Root example — MySQL local for Spring Boot backend.
# NEVER commit real production secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (Spring Boot) — MySQL
# Defaults are also hardcoded in backend/src/main/resources/application.properties
# -----------------------------------------------------------------------------
# jdbc:mysql://localhost:3306/warmup_library
# username: root
# password: 2004
#
# IMPORTANT: Do NOT leave User/IDE env vars as:
#   DB_URL=jdbc:postgresql://...
#   DB_USERNAME=postgres
# Those cause: password authentication failed for user "postgres"

PORT=8080
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# FRONTEND (Vite) — local proxy; production set on Vercel
# -----------------------------------------------------------------------------
VITE_API_URL=
